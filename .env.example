# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site
NEXT_PUBLIC_SITE_URL=https://dayspa.allbook.com.au

# Local dev tenant override (optional — subdomain resolution used in production)
TENANT_SLUG=dayspa

# Platform apex (allbook.com.au) /booking demo tenant
PLATFORM_BOOKING_TENANT_SLUG=dayspa

# Admin bootstrap login (optional — DB admin_accounts used when unset)
ADMIN_LOGIN_ID=
ADMIN_PASSWORD=

# Session signing (required in production)
APP_SESSION_SECRET=generate-a-long-random-string
STAFF_SESSION_SECRET=

# Stripe card payments (customer /booking checkout)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Stripe Dashboard → Webhooks → https://allbook.com.au/api/stripe/webhook
# Events: payment_intent.succeeded, payment_intent.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_...

# Web push (optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@allbook.com.au

# Cron / maintenance (optional)
MAINTENANCE_TOKEN=
