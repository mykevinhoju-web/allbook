# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site
NEXT_PUBLIC_SITE_URL=https://dayspa.allbook.com.au

# Local dev tenant override (optional — subdomain resolution used in production)
TENANT_SLUG=dayspa

# Admin bootstrap login (optional — DB admin_accounts used when unset)
ADMIN_LOGIN_ID=
ADMIN_PASSWORD=

# AllBook Admin (/platform) uses Supabase Auth email+password.
# Create the user in Supabase Auth, then:
#   update public.profiles set role = 'admin' where email = 'you@example.com';
# Only profiles.role = 'admin' can access /platform.

# Marketplace Private Preview (default ON). Set to false for public launch.
# PRIVATE_PREVIEW_MODE=false

# Session signing (required in production)
APP_SESSION_SECRET=generate-a-long-random-string
STAFF_SESSION_SECRET=

# Platform free-trial signup (Supabase Auth)
# Enable Email OTP + Google / Facebook under Authentication → Providers.
# Add redirect URL: https://allbook.com.au/auth/callback
# (and http://localhost:3000/auth/callback for local)

# Stripe card payments (customer /booking checkout)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Stripe Dashboard → Webhooks → https://allbook.com.au/api/stripe/webhook
# Events: payment_intent.succeeded, payment_intent.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_...

# Web push (optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@allbook.com.au

# Google Maps (marketplace map + geocoding)
# Enable: Maps JavaScript API + Geocoding API
# Restrict the browser key by HTTP referrer (allbook.com.au/*, localhost:3000/*)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Places (New) — business discovery import ONLY (server)
# Enable Places API (New) on the Google Cloud project.
# Prefer a server key (IP-restricted). Do not use this key in the browser.
# Marketplace search never calls Places at query time.
GOOGLE_PLACES_API_KEY=
# Optional fallback if GOOGLE_PLACES_API_KEY unset:
# GOOGLE_MAPS_API_KEY=

# Cron / maintenance (optional)
# Also authorizes POST /api/platform/import/google-places
MAINTENANCE_TOKEN=

# Marketplace matching demo (/marketplace/demo). Never set on Vercel production.
# ALLOW_MARKETPLACE_DEMO=true
